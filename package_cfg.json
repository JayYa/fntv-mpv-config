{
    "name": "fntv-mpv",
    "version": "1.0.0",
    "description": "MPV播放器和插件管理工具",
    "config": {
        "output_dir": "../fntv-electron/third_party",
        "temp_dir": "./temp",
        "custom_config_dir": "./custom_config",
        "github_proxy": "https://ghfast.top",
        "enable_proxy": false
    },
    "dependencies": {
        "mpv": {
            "name": "mpv播放器",
            "enabled": true,
            "url": "https://github.com/mpv-player/mpv/releases",
            "version": "v0.42.0",
            "filename_pattern": "mpv-{version}-x86_64-pc-windows-msvc",
            "format": "zip",
            "exclude_files": [
                "*.bat"
            ]
        },
        "uosc": {
            "name": "uosc插件",
            "enabled": true,
            "url": "https://github.com/tomasklaen/uosc/releases",
            "version": "5.13.0",
            "filename_pattern": "uosc",
            "format": "zip",
            "exclude_files": [
                "*.md",
                "LICENSE*"
            ],
            "custom_install_rules": [
                {
                    "from": "scripts",
                    "to": "portable_config/scripts",
                    "filter": ["**/*"]
                },
                {
                    "from": "fonts",
                    "to": "portable_config/fonts",
                    "filter": ["**/*"]
                }
            ]
        },
        "uosc_danmaku": {
            "name": "uosc弹幕插件",
            "enabled": true,
            "url": "https://github.com/Tony15246/uosc_danmaku/releases",
            "version": "v2.1.0",
            "filename_pattern": "uosc_danmaku",
            "format": "zip",
            "exclude_files": [
                "*.md",
                "LICENSE*"
            ]
        },
        "smart_skip": {
            "name": "智能跳过片头片尾插件",
            "enabled": true,
            "local_path": "./local_packages/smart_skip",
            "version": "local"
        },
        "thumbfast": {
            "name": "thumbfast缩略图插件",
            "enabled": true,
            "local_path": "./local_packages/thumbfast",
            "version": "local",
            "custom_install_rules": [
                {
                    "from": "",
                    "to": "portable_config/scripts",
                    "filter": ["thumbfast.lua"]
                }
            ]
        }
    }

}
