{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "group:allNonMajor"
  ],
  "rangeStrategy": "pin",
  "minimumReleaseAge": "3 days",
  "dependencyDashboard": {
    "autoclose": true
  },
  "lockFileMaintenance": { "enabled": false }
}
